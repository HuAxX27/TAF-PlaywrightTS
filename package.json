        "@playwright/test": "^1.62.1",
        "@types/node": "^26.2.0",
        "dotenv": "^17.4.2",
        "eslint": "^10.8.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-playwright": "^2.11.0",
        "prettier": "^3.9.6",
        "tsx": "^4.20.6",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.65.0"
    },
    "dependencies": {
        "axios": "^1.19.0"
