        "test:regression": "playwright test --grep @regression",
        "test:critical": "playwright test --grep @critical",
        "aqa:toolkit": "tsx agent/toolkit-cli.ts",
        "promote": "tsx agent/toolkit-cli.ts promote",
        "candidates": "tsx agent/toolkit-cli.ts status"
    },
    "keywords": [],
