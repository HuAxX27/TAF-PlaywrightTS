# ---------- Framework (Playwright) ----------
BASE_URL=https://www.cinepolis.com
TEST_ENV=dev

# credentials (solo si el sitio bajo prueba requiere login)
USER_EMAIL=usuario@ejemplo.com
USER_PASSWORD=changeme

# ---------- Agente AQA: proveedor de LLM ----------
# mock | gemini | groq | openrouter | ollama | codemie | custom
LLM_PROVIDER=mock

# El modelo y la URL de cada proveedor tienen default; descomenta para sobrescribir.
# LLM_MODEL=
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_MS=120000

# Solo se necesita la key del proveedor que estes usando:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CODEMIE_API_KEY=
# CUSTOM_API_KEY=

# ---------- Agente AQA: origen de la User Story ----------
# jira | file
STORY_SOURCE=file
STORY_DIR=agent/stories

JIRA_BASE_URL=https://tuempresa.atlassian.net
JIRA_EMAIL=tu.correo@empresa.com
JIRA_API_TOKEN=
# Campo custom donde tu Jira guarda los criterios de aceptacion (opcional)
# JIRA_AC_FIELD=customfield_10001

# ---------- Agente AQA: rutas ----------
TESTS_DIR=tests
GENERATED_TESTS_DIR=tests/generated
ARTIFACTS_DIR=agent/artifacts
