# ---------- Framework (Playwright) ----------
BASE_URL=https://your-application.example
TEST_ENV=dev

# credentials (solo si el sitio bajo prueba requiere login)
USER_EMAIL=usuario@ejemplo.com
USER_PASSWORD=changeme

# ---------- Agente AQA: proveedor de LLM ----------
# El flujo productivo usa Xray + CodeMie. Configura el id exacto de Sonnet que
# exponga tu proxy corporativo.
LLM_PROVIDER=codemie

# El modelo y la URL de cada proveedor tienen default; descomenta para sobrescribir.
# LLM_MODEL=<id-de-sonnet-4.5-en-codemie>
# LLM_BASE_URL=
# LLM_TEMPERATURE=0.2
# LLM_TIMEOUT_MS=120000

# Solo se necesita la key del proveedor que estes usando:
GEMINI_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=
CODEMIE_API_KEY=
# CUSTOM_API_KEY=

# ---------- Agente AQA: entrada Xray ----------
# API Keys globales de Xray Cloud (Xray > Settings > API Keys)
XRAY_BASE_URL=https://xray.cloud.getxray.app
XRAY_CLIENT_ID=
XRAY_CLIENT_SECRET=

# ---------- Agente AQA: rutas ----------
TESTS_DIR=tests
## Los candidates no forman parte de npm test hasta su promocion manual.
CANDIDATES_DIR=tests/candidates
ARTIFACTS_DIR=agent/artifacts

# ---------- Agente AQA: validación E2E ----------
# Habilitar ejecución de tests contra la app real después de generarlos (habilitado por defecto)
# Usa ENABLE_E2E_VALIDATION=false para deshabilitar
# ENABLE_E2E_VALIDATION=false
# Máximo de intentos de reparación con multiagentes si el test falla
MAX_E2E_REPAIR_ATTEMPTS=3
# Máximo de intentos de reparación estática (compilación/lint)
MAX_REPAIR_ATTEMPTS=2

# ---------- Agente AQA: involucramiento humano ----------
# El agente pregunta lo que tendria que asumir y espera tu aprobacion antes de
# cerrar. Se apaga con la bandera --yes o poniendo INTERACTIVE=false (CI).
# INTERACTIVE=false
# Rondas maximas de pregunta/cambios antes de cortar el ciclo
MAX_REVIEW_ROUNDS=5

# ---------- Agente AQA: clasificacion UI / API ----------
# Debajo de esta confianza (0-100) el agente te pide confirmar si el TC es UI o API
KIND_CONFIDENCE_THRESHOLD=80

# ---------- Agente AQA: validación final ----------
# Compara el test case original contra el codigo generado y reporta escenarios sin cubrir
# ENABLE_FINAL_VALIDATION=false

# ---------- Agente AQA: aprendizaje (agent/knowledge/, versionado en git) ----------
# Al cerrar cada sesion, destila lo aprendido (reparaciones, respuestas del QA,
# escenarios sin cubrir) en agent/knowledge/knowledge-base.json + KNOWLEDGE.md.
# ENABLE_LEARNING=false
# Tope de caracteres de conocimiento inyectado por prompt
KNOWLEDGE_CONTEXT_CHARS=6000
MAX_RULES_IN_PROMPT=12
MAX_RECIPES_IN_PROMPT=3
MAX_FACTS_IN_PROMPT=15
# Techo por sesion: obliga a priorizar en vez de inflar la base
MAX_NEW_RULES_PER_SESSION=5
MAX_NEW_FACTS_PER_SESSION=10
