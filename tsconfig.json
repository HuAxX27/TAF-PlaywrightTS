{
    "compilerOptions": {
        "target": "ES2022",
        "module": "CommonJS",
        "moduleResolution": "node",
        "lib": ["ES2022", "DOM"],
        "strict": true,
        "noImplicitOverride": true,
        "esModuleInterop": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true,
        "types": ["node"]
    },
    "include": ["src/**/*.ts", "tests/**/*.ts", "agent/**/*.ts", "playwright.config.ts"],
    "exclude": ["node_modules", "playwright-report", "test-results", "agent/artifacts"]
}
